# ── Browser ──────────────────────────────────────────────
# Absolute path to a Chrome or Chromium binary.
# Leave empty to use Playwright's own Chromium
# (install it with: zac install, or npx playwright install chromium).
# ~ is expanded, and a folder containing a "chrome" binary is accepted too.
AUTOCRAW_BROWSER_PATH=

# HTTP(S) proxy for crawling and browser requests.
# Format: protocol://user:password@host:port
AUTOCRAW_PROXY=

# Session file saved by: zac login <url> --session <file>
# Reuse it on any command with --session <file> to carry over
# cookies and the user agent (e.g. after you solve a login or captcha once).
AUTOCRAW_SESSION_FILE=

# Where autocraw keeps its cache (AI response cache, downloaded models).
# Default if left empty: ~/.cache/autocraw
AUTOCRAW_CACHE_DIR=

# Custom path to load env vars from (default: .env in the current directory).
AUTOCRAW_ENV_FILE=

# ── zac serve ────────────────────────────────────────────
# Bearer token required to call the local REST API (zac serve).
# Clients must send: Authorization: Bearer <this value>
# Required if you bind zac serve to anything other than 127.0.0.1/localhost.
# Generate one with: zac init (writes a random value here automatically).
AUTOCRAW_SERVER_KEY=

# ── AI providers (used by --markdown ai and extract) ────────
# A single key for either OpenAI or Anthropic; the provider is guessed
# from the key's prefix (sk-ant-... -> Anthropic, otherwise OpenAI).
# Prefer the provider-specific keys below when you use both.
AUTOCRAW_API_KEY=

OPENAI_API_KEY=
# Override the OpenAI-compatible endpoint, e.g. to point at a
# proxy, OpenRouter, or a local OpenAI-compatible server.
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# ── Local models via Ollama ──────────────────────────────
# If you run "ollama serve" yourself, autocraw can use it as an AI
# provider with --ai-provider ollama. No API key is needed.
# If either of these two is set and no OpenAI/Anthropic key is found,
# the ollama provider is picked automatically.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
