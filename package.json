{
  "name": "@zhadev/autocraw",
  "version": "0.0.1",
  "description": "Site intelligence crawler: tech stack, SSR/RSC detection, WordPress anime/manga templates, media inspection and Markdown reports (deterministic or AI generated).",
  "author": {
    "name": "zhadev",
    "url": "https://github.com/zhadevv"
  },
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "zac": "./dist/cli.js",
    "autocraw": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "assets/logo.svg",
    "README.md",
    "README.id.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run docs:llms && npm run build",
    "docs:llms": "node scripts/build-llms.mjs"
  },
  "keywords": [
    "ai",
    "anime",
    "crawler",
    "extract",
    "firecrawl",
    "llm",
    "manga",
    "map",
    "markdown",
    "mcp-friendly",
    "playwright",
    "rest-api",
    "rsc",
    "scraper",
    "seo",
    "site-analysis",
    "ssr",
    "structured-data",
    "web-scraper",
    "wordpress",
    "zac"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.76.0",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "handlebars": "^4.7.9",
    "js-tiktoken": "^1.0.15",
    "jsdom": "^30.1.3",
    "openai": "^7.53.0",
    "playwright": "^1.65.0",
    "rusteerio": "^2.0.0",
    "undici": "^8.12.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhadevv/autocraw.git"
  },
  "bugs": {
    "url": "https://github.com/zhadevv/autocraw/issues"
  },
  "homepage": "https://github.com/zhadevv/autocraw#readme",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
